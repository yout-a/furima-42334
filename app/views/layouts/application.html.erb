<!DOCTYPE html>
<html>

<head>
  <title>Furima</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <!-- Pay.jp v2 を先に読み込む -->
  <script src="https://js.pay.jp/v2/pay.js" defer data-turbo-track="reload"></script>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <meta name="payjp-public-key" content="<%= ENV.fetch('PAYJP_PUBLIC_KEY', '') %>">
  <%= javascript_importmap_tags %>
  <%= include_gon %>
</head>

<body>
  <%= yield %>
</body>

</html>